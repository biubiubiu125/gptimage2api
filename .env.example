# ============================================
# GPTImage2API 环境变量配置示例
# ============================================

# 认证密钥（必填）
GPTIMAGE2API_AUTH_KEY=your_secret_key_here
# 注册核心结果恢复文件使用认证密钥派生加密密钥；如需独立轮换，可单独设置：
# GPTIMAGE2API_REGISTER_RECOVERY_KEY=another_secret_key
# 注册配置数据库的 AES-GCM 加密密钥；未设置时回退到恢复密钥或认证密钥：
# GPTIMAGE2API_REGISTER_CONFIG_KEY=another_register_config_key

# 上游生图资源下载响应的最大字节数，默认 50 MiB：
# GPTIMAGE2API_IMAGE_DOWNLOAD_MAX_BYTES=52428800

# Web / API 暴露端口
GPTIMAGE2API_PORT=2080

# 后端同步工作线程并发容量；只要求正整数，不设置人为最高值。
# 它控制同步工作可同时占用的线程数，不等于账号、代理或上游服务的实际并发上限。
GPTIMAGE2API_THREAD_TOKENS=120

# Docker 镜像，可固定为 ghcr.io/biubiubiu125/gptimage2api:latest
GPTIMAGE2API_IMAGE=ghcr.io/biubiubiu125/gptimage2api:latest

# 发布后可配置 GitHub 仓库（owner/name）；未配置时关闭在线版本检查。
# GPTIMAGE2API_GITHUB_REPOSITORY=biubiubiu125/gptimage2api

# 基础 URL（可选，用于生成图片 URL）
# GPTIMAGE2API_BASE_URL=https://your-domain.com

# ============================================
# 应用数据库
# ============================================

# 未设置时使用 data/gptimage2api.db
# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/gptimage2api_app

# 本地 PostgreSQL Compose overlay（docker-compose.postgres.yml）
# 密码仅使用字母、数字、下划线或连字符，避免连接 URI 编码不一致。
# POSTGRES_DB 固定为 gptimage2api_app，不需要填写
# POSTGRES_USER=gptimage2api
# POSTGRES_PASSWORD=replace_with_a_strong_password

# Supabase 示例（连接字符串中的数据库名必须是 gptimage2api_app）
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/gptimage2api_app

# SQLite 示例
# DATABASE_URL=sqlite:////app/data/gptimage2api.db

# ============================================
# 单体持久化生图队列
# ============================================

# 队列使用独立 PostgreSQL 数据库，不与 Application Database 混用。
# GPTIMAGE2API_IMAGE_QUEUE_DATABASE_URL=postgresql://user:password@localhost:5432/gptimage2api_image_queue
# GPTIMAGE2API_IMAGE_QUEUE_ARTIFACT_ROOT=data/images
# GPTIMAGE2API_IMAGE_QUEUE_GENERATION_CONCURRENCY=4
# GPTIMAGE2API_IMAGE_QUEUE_MAX_BACKLOG=256

# ============================================
# 注册机邮箱供应商（仅保留四种）
# ============================================

# yyds_mail / remail / outlook_token / icloud_api
# 注册配置保存在 Application Database；data/register.json 仅作为首次启动导入源。
# 旧配置中的其他 provider 会在导入时丢弃，敏感字段不提交到 Git。
